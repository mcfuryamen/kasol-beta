# Supabase Configuration Template
# Copy this file to .env.local and fill in the values

SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_ANON_KEY=******
SUPABASE_SERVICE_ROLE_KEY=******
# Gate untuk /api/rest dan /api/license — WAJIB di-set (fail-closed).
# Kalau kosong, kedua endpoint return 503 server_not_configured (bukan terbuka).
ADMIN_API_KEY=******

# ===== Salt lisensi (Fix C1 - SERVER-SIDE ONLY, JANGAN pernah di client) =====
# Kalau dikosongkan, server pakai default (lihat api/license.js).
# Wajib SAMA dengan PRODUCT_SALT di tiap app klien biar serial yang dibuat
# diterima app. Override per-produk (opsional):
LICENSE_SALT_KAKI5=KASIRSOLO-KAKI5-HMAC-V2
LICENSE_SALT_ROSOK=KASIRSOLO-ROSOK-HMAC-V2
LICENSE_SALT_GEROBAK=KASIRSOLO-GEROBAK-HMAC-V2
LICENSE_SALT_RETAIL=KASIRSOLO-RETAIL-HMAC-V2
# Atau satu JSON sekaligus: LICENSE_SALTS={"KSR":"...","KK5":"..."}