---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `Program Mitra — ${site.legalName}`,
  description =
    'Daftar jadi mitra Kasir Solo: lo cuma nunjuk, mereka beli, lo dapet komisi. Tanpa modal, tanpa stok. Mereka juga dapat diskon lisensi pertama.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/icon-512.png', Astro.site);

const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${Astro.site}#org`,
  name: site.legalName,
  url: `${Astro.site}`,
  logo: new URL('/icon-512.png', Astro.site).toString(),
  description:
    'Program mitra Kasir Solo — rekomendasi aplikasi kasir, orang yang kamu tunjuk dapat diskon, kamu dapat komisi.',
  telephone: '+628816566935',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Perum Graha Tiara 2 B1, Kartasura',
    addressLocality: 'Sukoharjo',
    addressRegion: 'Jawa Tengah',
    postalCode: '57557',
    addressCountry: 'ID',
  },
  sameAs: [`https://wa.me/${site.whatsapp}`],
};
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.legalName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="id_ID" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- PWA -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#FF5F1F" />

    <script type="application/ld+json" set:html={JSON.stringify(org)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script is:inline>
      try {
        var l = localStorage.getItem('mks-lang');
        if (l === 'en') document.documentElement.lang = 'en';
        document.documentElement.setAttribute('data-lang', l === 'en' ? 'en' : 'id');
      } catch (e) { /* privat mode */ }
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href={site.mainSite} class="brand">
          <img src="/icon-192.png" alt="Logo KASIRSOLO" width="40" height="40" />
          <span class="brand-text">
            <strong>KASIR<span class="solo">SOLO</span></strong>
            <small>{site.legalName}</small>
          </span>
        </a>
        <nav class="nav">
          <a class="nav-link" href="/" data-i18n="m.nav.program">Program Mitra</a>
          <a class="nav-link" href="/#cara" data-i18n="m.nav.cara">Cara Kerjainya</a>
          <a class="nav-link" href="/#faq" data-i18n="m.nav.faq">FAQ</a>
          <a class="nav-link" href="/portal" data-i18n="m.nav.portal">Portal Mitra</a>
          <button class="nav-lang" id="langToggle" type="button" data-lang="id" aria-pressed="false" data-i18n-aria="nav.aria.lang" aria-label="Switch language / Ganti bahasa" title="Bahasa: Indonesia — klik untuk English">
            <span class="flag flag-id" aria-hidden="true"><svg viewBox="0 0 24 16" xmlns="http://www.w3.org/2000/svg"><rect width="24" height="8" fill="#e70011"/><rect y="8" width="24" height="8" fill="#f5f5f5"/></svg></span>
            <span class="flag flag-en" aria-hidden="true"><svg viewBox="0 0 60 30" xmlns="http://www.w3.org/2000/svg"><clipPath id="uk-s"><path d="M0,0 v30 h60 v-30 z"/></clipPath><clipPath id="uk-t"><path d="M30,15 h30 v15 z v15 h-30 z h-30 v-15 z v-15 h30 z"/></clipPath><g clip-path="url(#uk-s)"><path d="M0,0 v30 h60 v-30 z" fill="#012169"/><path d="M0,0 60,30M60,0 0,30" stroke="#fff" stroke-width="6"/><path d="M30,0 60,30M30,0 0,30" clip-path="url(#uk-t)" stroke="#C8102E" stroke-width="4"/><path d="M30,0 v30 M0,15 h60" stroke="#fff" stroke-width="10"/><path d="M30,0 v30 M0,15 h60" stroke="#C8102E" stroke-width="6"/></g></svg></span>
          </button>
          <a class="btn btn-primary nav-cta" href="/portal">
            <span data-i18n="m.nav.masuk">Masuk Portal</span><span class="shine"></span>
          </a>
          <a class="nav-wa-short" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener" aria-label="WhatsApp">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
          </a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-glowline"></div>
      <div class="container">
        <div class="footer-grid">
          <div class="f-col f-brand">
            <h3>{site.legalName}</h3>
            <div class="f-bar"></div>
            <p data-i18n="m.footer.tagline">Program mitra untuk siapa pun yang merekomendasikan aplikasi kasir kami. Lo nunjuk, mereka dapat diskon, lo dapat komisi.</p>
            <div class="f-socials">
              <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener" aria-label="WhatsApp">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
              </a>
              <a href={site.mainSite} aria-label="Situs utama">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M2 12h20"></path><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
              </a>
            </div>
          </div>

          <div class="f-col">
            <h4 data-i18n="m.footer.program">Program Mitra</h4>
            <ul>
              <li><a href="/" data-i18n="m.footer.program">Program Mitra</a></li>
              <li><a href="/daftar" data-i18n="m.footer.daftar">Daftar Mitra</a></li>
              <li><a href="/portal" data-i18n="m.footer.portal">Portal Mitra</a></li>
              <li><a href="/#faq" data-i18n="m.nav.faq">FAQ</a></li>
            </ul>
          </div>

          <div class="f-col">
            <h4 data-i18n="m.footer.kasir">Kasir Solo</h4>
            <ul>
              <li><a href={`${site.mainSite}/about`} data-i18n="m.footer.tentang">Tentang Kami</a></li>
              <li><a href={`${site.mainSite}/hardware`} data-i18n="m.footer.hardware">Hardware Kasir</a></li>
              <li><a href={`${site.mainSite}/#aplikasi`} data-i18n="m.footer.kasir">Aplikasi Kasir</a></li>
              <li><a href={`${site.mainSite}/portfolio`} data-i18n="m.footer.portfolio">Klien &amp; Portfolio</a></li>
              <li><a href={`${site.mainSite}/#jangkauan`} data-i18n="m.footer.area">Area Layanan</a></li>
            </ul>
          </div>

          <div class="f-col f-contact">
            <h4 data-i18n="m.footer.hubungi">Hubungi Kami</h4>
            <ul>
              <li>
                <span class="f-ic"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg></span>
                <div><small data-i18n="m.footer.kantorLegal">KANTOR LEGAL</small><p>Perum Graha Tiara 2 B1, Kartasura</p></div>
              </li>
              <li>
                <span class="f-ic"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg></span>
                <div><small data-i18n="m.footer.kantorOps">KANTOR OPERASIONAL</small><p>Gumiring 04/04, Banjarejo</p></div>
              </li>
              <li>
                <span class="f-ic"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91"></path><path d="M23 7 16.5 13.5"></path><path d="M16.5 7 23 13.5"></path></svg></span>
                <div><small data-i18n="m.footer.whatsapp">WHATSAPP</small><p><a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener" data-i18n="m.footer.chatFounder">Chat Founder Langsung</a></p></div>
              </li>
            </ul>
          </div>
        </div>

        <div class="footer-bottom">
          <p>© {new Date().getFullYear()} <strong>PT Mesin Kasir Solo</strong>. All Rights Reserved.</p>
          <div class="f-legal">
            <a href={site.mainSite} data-i18n="m.footer.situsUtama">Situs utama</a>
            <a href={`${site.mainSite}/#aplikasi`} data-i18n="m.footer.privasi">Privasi</a>
            <a href={`${site.mainSite}/#aplikasi`} data-i18n="m.footer.syarat">Syarat &amp; Ketentuan</a>
          </div>
        </div>
      </div>
    </footer>

    <button id="toTop" class="to-top" type="button" data-i18n-aria="nav.aria.top" aria-label="Kembali ke atas">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"></line><polyline points="5 12 12 5 19 12"></polyline></svg>
    </button>

    <nav class="tabbar" data-i18n-aria="tab.aria.utama" aria-label="Navigasi utama">
      <a href="/" data-tab="beranda" class="active" aria-label="Beranda">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
        <span data-i18n="m.tab.beranda">Beranda</span>
      </a>
      <a href="/#program" data-tab="program" aria-label="Program">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
        <span data-i18n="m.tab.program">Program</span>
      </a>
      <div class="tab-fab" aria-hidden="false">
        <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener" class="fab" aria-label="Chat Founder">
          <img src="/icon-192.png" alt="" width="28" height="28" />
        </a>
      </div>
      <a href="/portal" data-tab="portal" aria-label="Portal">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
        <span data-i18n="m.tab.portal">Portal</span>
      </a>
      <a href="/daftar" data-tab="daftar" aria-label="Daftar">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="19" y1="8" x2="19" y2="14"></line><line x1="22" y1="11" x2="16" y2="11"></line></svg>
        <span data-i18n="m.tab.daftar">Daftar</span>
      </a>
    </nav>

    <script>
      import { initI18n } from '../i18n/client';
      initI18n();

      const toTop = document.getElementById('toTop');
      if (toTop) {
        const onScroll = () => toTop.classList.toggle('show', window.scrollY > 420);
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
        toTop.addEventListener('click', () => {
          const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollTo({ top: 0, behavior: smooth ? 'smooth' : 'auto' });
        });
      }

      // Tab bar: tandai tab aktif sesuai pathname
      const tabs = document.querySelectorAll('.tabbar a[data-tab]');
      if (tabs.length) {
        const path = location.pathname.replace(/\/$/, '');
        let key = 'beranda';
        if (path === '/portal') key = 'portal';
        else if (path === '/daftar') key = 'daftar';
        else if (path.startsWith('/r/')) key = 'program';
        tabs.forEach((t) => t.classList.toggle('active', t.dataset.tab === key));
      }
    </script>
  </body>
</html>
