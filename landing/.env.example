# Supabase Configuration Template - KASIRSOLO
# Copy this file to .env.local and fill in the values
#
# CATATAN KEAMANAN (Phase A): Landing HANYA butuh ANON key (publik, aman di browser).
# JANGAN pernah menaruh SUPABASE_SERVICE_ROLE_KEY di landing - kalau kedapatan
# di browser = full akses ke seluruh database. Service key tidak pernah di sini.

SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_ANON_KEY=PUBLIC_ANON_KEY_HERE
