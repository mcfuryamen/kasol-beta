{
  "name": "tpa-identity-recovery",
  "version": "1.0.0",
  "description": "TPA Identity Recovery System with Supabase Backend",
  "type": "module",
  "scripts": {
    "test": "mocha 'services/identity/**/*.spec.js' 'services/authorization.spec.js' 'services/tpa-remote.spec.js' 'services/tpa-spp-remote.spec.js' 'services/tpa-attendance-normalize.spec.js' 'services/tpa-student-normalize.spec.js' 'services/tpa-academic-normalize.spec.js' 'services/tpa-assignment-normalize.spec.js' 'services/tpa-progress-normalize.spec.js' 'scripts/verify-academic-attendance-staging.spec.js' 'scripts/smoke-rls-staging.spec.js' 'db/**/*.spec.js' --timeout 5000 --reporter spec",
    "test:otp": "mocha 'services/otp/**/*.spec.js' --timeout 5000 --reporter spec",
    "test:transport": "mocha services/identity/supabase-transport.spec.js --timeout 5000 --reporter spec",
    "test:identity": "mocha 'services/identity/**/*.spec.js' --timeout 5000 --reporter spec",
    "test:watch": "mocha 'services/**/*.spec.js' --watch --timeout 5000 --reporter spec",
    "dev": "vite --host 127.0.0.1 --port 8088 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 8088 --strictPort"
  },
  "keywords": [
    "identity",
    "recovery",
    "authentication",
    "supabase",
    "pin",
    "otp",
    "whatsapp"
  ],
  "author": "KASOL Team",
  "license": "MIT",
  "devDependencies": {
    "chai": "^4.3.10",
    "form-data": "^4.0.6",
    "mocha": "^10.2.0",
    "sinon": "^22.1.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "pg": "^8.23.1",
    "twilio": "^6.1.2"
  }
}
