# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================
# These are public credentials (safe to commit for development)
# For production: use separate .env.production with secured keys

# Public Supabase URL (anon client)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Public Supabase Anon Key (safe to expose in browser)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================================================
# SERVER-SIDE SECRETS (NOT exposed to browser)
# ============================================================================
# Store these in Vercel/deployment platform environment variables only
# NEVER commit these to git

# Management API token for Supabase CLI (not a JWT; keep secret)
# SUPABASE_ACCESS_TOKEN=your-management-api-token-here

# Database password for `supabase db push` / psql (not a JWT; keep secret)
# SUPABASE_DB_PASSWORD=your-database-password-here

# Service Role Key is only for trusted server-side Supabase API clients.
# Never use it as SUPABASE_ACCESS_TOKEN or SUPABASE_DB_PASSWORD.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================================
# OTP PROVIDER (SMS/WhatsApp)
# ============================================================================
# Twilio
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# OR MessageBird
MESSAGEBIRD_API_KEY=your-api-key
MESSAGEBIRD_ORIGINATOR=YourBrand

# ============================================================================
# APP CONFIGURATION
# ============================================================================
VITE_APP_NAME=TPA
VITE_APP_ENV=development
VITE_API_BASE_URL=http://127.0.0.1:8088/api
