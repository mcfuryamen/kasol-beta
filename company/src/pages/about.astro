---
import Base from '../layouts/Base.astro';
import { about, site } from '../data/portfolio';

const title = 'Tentang Kami — Sejarah & Legalitas PT Mesin Kasir Solo | KASIRSOLO';
const description =
  'Bukan vendor biasa. Cerita Amin Maghfuri: sales jalanan 2015, 500+ outlet 2019, kiamat digital 2022, comeback 2025. Legalitas PT Mesin Kasir Solo bisa dicek sendiri di OSS.';

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: `${Astro.site}` },
    { '@type': 'ListItem', position: 2, name: 'Tentang', item: new URL('/about', Astro.site).toString() },
  ],
};

const icons: Record<string, string> = {
  history: '<path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l4 2"/>',
  rocket: '<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>',
  skull: '<path d="M6 15V8a6 6 0 0 1 12 0v7"/><path d="M20 15v2a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-2"/><circle cx="8" cy="15" r="4"/><circle cx="16" cy="15" r="4"/><path d="M12 17v5"/>',
  sunrise: '<path d="M12 2v8"/><path d="m4.93 10.93 1.41 1.41"/><path d="M2 18h2"/><path d="M20 18h2"/><path d="m19.07 10.93-1.41 1.41"/><path d="M22 22H2"/><path d="m8 6 4-4 4 4"/><path d="M16 18a4 4 0 0 0-8 0"/>',
  shield: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
  badge: '<path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/><path d="m9 12 2 2 4-4"/>',
};
const toneClass: Record<string, string> = { orange: 'ch-orange', blue: 'ch-blue', red: 'ch-red' };
---
<Base title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />

  {/* ============ HERO ============ */}
  <section class="hero about-hero">
    <div class="hero-bg">
      <div class="orb-1"></div>
      <div class="grid-lines"></div>
    </div>
    <span class="story-watermark" aria-hidden="true">STORY</span>
    <div class="hero-inner">
      <h1 class="anim-fade anim-d1" data-i18n="about.heroTitle">Gue Bukan <span class="accent">Vendor.</span></h1>
      <p class="hero-sub anim-fade anim-d2" data-i18n="about.heroSub">
        Vendor biasa cuma peduli barang laku terus kabur. Gue peduli bisnis lo bertahan hidup.
        Di medan perang ritel yang kejam ini, lo butuh lebih dari sekadar penjual alat.<br />
        <strong class="hero-strong">Gue Partner Perang lo.</strong>
      </p>
    </div>
  </section>

  {/* ============ STORY — COMMANDING OFFICER ============ */}
  <section class="block" id="cerita">
    <div class="container">
      <div class="officer-grid">
        <div class="founder-photo">
          {about.founder.portrait
            ? <img src={about.founder.portrait} alt={`${about.founder.name} — Founder`} width="450" height="600" />
            : (
              <div class="founder-placeholder" role="img" aria-label="Foto founder (segera)">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"></path></svg>
                <span>FOTO FOUNDER<br /><small>segera</small></span>
              </div>
            )}
        </div>
        <div class="officer-body">
          <span class="kicker-pill">{about.founder.kicker}</span>
          <h2 class="officer-name">{about.founder.name}</h2>
          <p class="officer-tagline">{about.founder.tagline}</p>
          <div class="officer-quote-wrap">
            <span class="quote-bg" aria-hidden="true">"</span>
            <h3 class="officer-quote">{about.story.quoteHeading}</h3>
          </div>
          <p class="officer-text">{about.story.body}</p>
          <div class="lesson-box">
            <p>{about.story.lesson}</p>
          </div>
          <div class="battle-line">
            <span class="battle-rule" aria-hidden="true"></span>
            <span class="battle-text">{about.founder.battleTested}</span>
          </div>
        </div>
      </div>

      <div class="turn-block">
        <h3 class="turn-title-big">{about.story.turnTitle}</h3>
        <div class="turn-body">
          {about.story.turn.map((p) => <p class="story-p" set:html={p} />)}
        </div>
      </div>
    </div>
  </section>

  {/* ============ TIMELINE ============ */}
  <section class="block tint" id="perjalanan">
    <div class="container">
      <div class="section-head center">
        <span class="kicker-pill" data-i18n="about.timelineKicker">Timeline</span>
        <h2 data-i18n="about.timelineTitle">Dari Nol, ke Puncak, ke <span class="hl">Nol Lagi.</span></h2>
        <p class="sub" data-i18n="about.timelineSub">Empat chapter yang ngebentuk cara gue bangun sistem sekarang.</p>
      </div>
      <div class="timeline">
        {about.timeline.map((c, i) => (
          <div class={`chapter ${toneClass[c.tone] ?? 'ch-orange'} ${i % 2 === 1 ? 'ch-right' : 'ch-left'} ${c.icon === 'sunrise' ? 'ch-sun' : ''}`}>
            <div class="ch-dot" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons[c.icon]} />
            </div>
            <div class="ch-body">
              <span class="ch-kicker">{c.chapter}</span>
              <h3 class="ch-title">{c.year}: {c.title}</h3>
              {c.quote && <blockquote class="ch-quote">{c.quote}</blockquote>}
              <p class="ch-text" set:html={c.text} />
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ============ MARKAS + KONTAK (satu modul menyatu) ============ */}
  <section class="office-merge" id="markas">
    <div class="office-band">
      {about.office.image
        ? <img src={about.office.image} alt="Kantor PT Mesin Kasir Solo" />
        : (
          <div class="office-placeholder">
            <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2"/><path d="M9 22v-4h6v4"/><path d="M8 6h.01"/><path d="M16 6h.01"/><path d="M12 6h.01"/><path d="M12 10h.01"/><path d="M16 10h.01"/><path d="M8 10h.01"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/></svg>
            <span>FOTO MARKAS — SEGERA</span>
          </div>
        )}
      <div class="office-caption">
        <span class="office-kicker" data-i18n="about.hubungiMarkas">HUBUNGI MARKAS</span>
        <h3>{about.office.title}</h3>
        <p>{about.office.sub}</p>
      </div>
    </div>

    <div class="container">
      <div class="contact-panel">
        <div class="cp-head">
          <span class="kicker-pill" data-i18n="about.kontakKicker">Kontak Langsung</span>
          <h3 data-i18n="about.kontakTitle">Bicara Langsung Sama Gue.</h3>
          <p data-i18n="about.kontakSub">Gak ada call center, gak ada proxy. Lo chat, gue yang jawab.</p>
        </div>
        <div class="cp-grid">
          <div class="cp-col">
            <div class="cp-row">
              <div class="cp-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
              </div>
              <div class="cp-body">
                <span class="cp-label" data-i18n="about.waLabel">WhatsApp — Jawaban Tercepat</span>
                <strong class="cp-value">{site.phoneDisplay}</strong>
                <span class="cp-note" data-i18n="about.waNote">Senin–Sabtu, 08.00–21.00 WIB. Konsultasi &amp; support, gratis.</span>
                <a class="btn btn-primary cp-cta" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">Chat Sekarang<span class="shine"></span></a>
              </div>
            </div>
          </div>
          <div class="cp-col">
            <div class="cp-row">
              <div class="cp-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
              </div>
              <div class="cp-body">
                <span class="cp-label" data-i18n="about.emailLabel">Email Resmi</span>
                <a class="cp-value cp-link" href="mailto:owner.kasirsolo@gmail.com">owner.kasirsolo@gmail.com</a>
                <span class="cp-note" data-i18n="about.emailNote">Penawaran resmi, invoice, dan kerja sama B2B.</span>
              </div>
            </div>
          </div>
          <div class="cp-col">
            <div class="cp-row">
              <div class="cp-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              </div>
              <div class="cp-body">
                <span class="cp-label" data-i18n="about.kantorLegal">{site.address.legal.label}</span>
                <strong class="cp-value">Kartasura, Sukoharjo</strong>
                <span class="cp-note">{site.address.legal.street}, {site.address.legal.city}</span>
              </div>
            </div>
            <div class="cp-row cp-row-divided">
              <div class="cp-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              </div>
              <div class="cp-body">
                <span class="cp-label" data-i18n="about.kantorOps">{site.address.operational.label}</span>
                <strong class="cp-value">Blora</strong>
                <span class="cp-note">{site.address.operational.street}, {site.address.operational.city}</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ============ LEGALITAS ============ */}
  <section class="block" id="legal" style="padding-bottom: 0;">
    <div class="container">
      <div class="legal-head">
        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons.shield} />
        <h2 data-i18n="about.legalTitle">Gue Main Bersih.</h2>
        <p class="sub" data-i18n="about.legalSub">Bisnis itu soal kepercayaan. Gue gak mau ngerusak nama yang udah gue bangun lagi dari nol. Ini buktinya gue legal.</p>
      </div>
      <div class="legal-card">
        <div class="legal-rows">
          {about.legality.rows.map((r) => (
            <div class="legal-row">
              <span class="legal-label">{r.label}</span>
              <span class={`legal-value ${r.mono ? 'mono' : ''}`}>
                {r.badge && <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#60a5fa" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons.badge} />}
                {r.value}
              </span>
              {r.sub && <span class="legal-sub">{r.sub}</span>}
            </div>
          ))}
          <p class="legal-note">{about.legality.note}</p>
        </div>
        <div class="legal-check">
          <p class="lc-title" data-i18n="about.lcTitle">Cek Validitas</p>
          <p class="lc-sub" data-i18n="about.lcSub">Lo bisa cek sendiri data perusahaan gue di web pemerintah biar yakin.</p>
          <a href={about.legality.ossUrl} target="_blank" rel="noopener" class="btn btn-primary">Buka OSS.GO.ID<span class="shine"></span></a>
        </div>
      </div>
    </div>
  </section>

</Base>

<style>
  /* ── Markas + kontak menyatu: band sinematik + panel komando ── */
  .office-merge .office-band { height: 480px; }
  .office-kicker {
    display: inline-block; margin-bottom: 10px;
    color: var(--orange); font-size: 10.5px; font-weight: 800;
    letter-spacing: .22em; text-transform: uppercase;
  }
  .office-merge .office-caption { padding-bottom: 170px; }
  .office-merge .office-placeholder { padding-bottom: 170px; }

  .contact-panel {
    position: relative; z-index: 2;
    margin-top: -110px;
    background: var(--card);
    border: 1px solid var(--line-2);
    border-radius: 20px;
    padding: 34px 38px 38px;
    box-shadow: 0 30px 70px rgba(0, 0, 0, .45);
  }
  .cp-head { text-align: center; margin-bottom: 30px; }
  .cp-head h3 { margin: 12px 0 6px; font-size: clamp(20px, 2.6vw, 26px); color: #fff; }
  .cp-head p { margin: 0; color: var(--text-2); font-size: 14px; }

  .cp-grid { display: grid; grid-template-columns: 1.15fr 1fr 1.15fr; }
  .cp-col { padding: 4px 28px; display: flex; flex-direction: column; gap: 22px; }
  .cp-col:first-child { padding-left: 0; }
  .cp-col:last-child { padding-right: 0; }
  .cp-col + .cp-col { border-left: 1px solid var(--line); }
  .cp-row { display: flex; gap: 14px; align-items: flex-start; }
  .cp-row-divided { border-top: 1px dashed var(--line-2); padding-top: 22px; }
  .cp-icon {
    flex: 0 0 auto; width: 42px; height: 42px; border-radius: 11px;
    display: grid; place-items: center;
    color: var(--orange); background: rgba(255, 95, 31, .1);
    border: 1px solid rgba(255, 95, 31, .3);
  }
  .cp-body { min-width: 0; display: flex; flex-direction: column; gap: 3px; }
  .cp-label {
    font-size: 10.5px; font-weight: 800; letter-spacing: .14em;
    text-transform: uppercase; color: var(--orange);
  }
  .cp-value { font-family: var(--font-display); font-size: 19px; font-weight: 700; color: #fff; }
  a.cp-value { text-decoration: none; overflow-wrap: anywhere; font-size: 16px; }
  a.cp-value:hover { color: var(--orange); }
  .cp-note { color: var(--text-2); font-size: 12.5px; line-height: 1.6; }
  .cp-cta { margin-top: 12px; align-self: flex-start; }

  @media (max-width: 900px) {
    .contact-panel { margin-top: -80px; padding: 28px 24px 30px; }
    .cp-grid { grid-template-columns: 1fr; gap: 26px; }
    .cp-col { padding: 0; }
    .cp-col + .cp-col { border-left: none; border-top: 1px solid var(--line); padding-top: 26px; }
  }
</style>
