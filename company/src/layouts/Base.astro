---
import '../styles/global.css';
import { site } from '../data/portfolio';

interface Props {
  title?: string;
  description?: string;
  /** Halaman tanpa header/footer (mis. splash) — tidak dipakai saat ini */
  bare?: boolean;
}

const {
  title = `${site.brand} — ${site.tagline}`,
  description = site.heroSubtitle,
} = Astro.props;

// --- SEO: canonical + OG ---
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/icon-512.png', Astro.site);

// --- LocalBusiness JSON-LD (pin alamat legal Sukoharjo) ---
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'Store',
  '@id': `${Astro.site}#business`,
  name: site.legalName,
  description: 'Mitra teknologi untuk UMKM: mesin kasir Android/PC, aplikasi kasir offline-first (kaki5, Rosok), portal SIBOS ERP, QALAM, dan jasa pengembangan website.',
  url: `${Astro.site}`,
  telephone: '+628816566935',
  priceRange: 'Rp2.500.000 - Rp18.500.000',
  logo: new URL('/icon-512.png', Astro.site).toString(),
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Perum Graha Tiara 2 B1, Kartasura',
    addressLocality: 'Sukoharjo',
    addressRegion: 'Jawa Tengah',
    postalCode: '57557',
    addressCountry: 'ID',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: -7.5686043,
    longitude: 110.7532941,
  },
  areaServed: [
    'Surakarta', 'Sukoharjo', 'Karanganyar', 'Sragen', 'Klaten', 'Boyolali',
    'Wonogiri', 'Semarang', 'Yogyakarta', 'Blora', 'Rembang', 'Sidoarjo',
  ].map((c) => ({ '@type': 'City', name: c })),
  sameAs: [
    `https://wa.me/${site.whatsapp}`,
  ],
};
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.legalName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="id_ID" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- PWA -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#FF5F1F" />

    <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script is:inline>
      try {
        var l = localStorage.getItem('mks-lang');
        if (l === 'en') document.documentElement.lang = 'en';
        document.documentElement.setAttribute('data-lang', l === 'en' ? 'en' : 'id');
      } catch (e) { /* privat mode */ }
    </script>
  </head>
  <body>
    <!-- Top bar: desktop nav / mobile app bar -->
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="brand">
          <img src="/icon-192.png" alt="Logo KASIRSOLO" width="40" height="40" />
          <span class="brand-text">
            <strong>KASIR<span class="solo">SOLO</span></strong>
            <small>{site.legalName}</small>
          </span>
        </a>
        <nav class="nav">
          <div class="nav-group">
            <span class="nav-link nav-parent" aria-haspopup="true" data-i18n="nav.perusahaan">Perusahaan
              <svg class="nav-caret" xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
            </span>
            <div class="nav-menu">
              <a href="/about" data-i18n="nav.menu.profil">Profil</a>
              <a href="/visi-misi" data-i18n="nav.menu.visiMisi">Visi &amp; Misi</a>
              <a href="/rekrutmen" data-i18n="nav.menu.rekrutmen">Rekrutmen</a>
              <a href="/portfolio" data-i18n="nav.menu.portfolio">Portfolio</a>
            </div>
          </div>
          <div class="nav-group">
            <span class="nav-link nav-parent" aria-haspopup="true" data-i18n="nav.layanan">Layanan
              <svg class="nav-caret" xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
            </span>
            <div class="nav-menu">
              <a href="/#aplikasi" data-i18n="nav.menu.aplikasi">Aplikasi</a>
              <a href="/hardware" data-i18n="nav.menu.mesin">Mesin</a>
            </div>
          </div>
          <a class="nav-link" href="/#jangkauan" data-i18n="nav.jangkauan">Jangkauan</a>
          <button class="nav-lang" id="langToggle" type="button" data-lang="id" aria-pressed="false" data-i18n-aria="nav.aria.lang" aria-label="Switch language / Ganti bahasa" title="Bahasa: Indonesia — klik untuk English">
            <span class="flag flag-id" aria-hidden="true"><svg viewBox="0 0 24 16" xmlns="http://www.w3.org/2000/svg"><rect width="24" height="8" fill="#e70011"/><rect y="8" width="24" height="8" fill="#f5f5f5"/></svg></span>
            <span class="flag flag-en" aria-hidden="true"><svg viewBox="0 0 60 30" xmlns="http://www.w3.org/2000/svg"><clipPath id="uk-s"><path d="M0,0 v30 h60 v-30 z"/></clipPath><clipPath id="uk-t"><path d="M30,15 h30 v15 z v15 h-30 z h-30 v-15 z v-15 h30 z"/></clipPath><g clip-path="url(#uk-s)"><path d="M0,0 v30 h60 v-30 z" fill="#012169"/><path d="M0,0 60,30M60,0 0,30" stroke="#fff" stroke-width="6"/><path d="M0,0 60,30M60,0 0,30" clip-path="url(#uk-t)" stroke="#C8102E" stroke-width="4"/><path d="M30,0 v30 M0,15 h60" stroke="#fff" stroke-width="10"/><path d="M30,0 v30 M0,15 h60" stroke="#C8102E" stroke-width="6"/></g></svg></span>
          </button>
          <a class="btn btn-primary nav-cta" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">
            <span data-i18n="nav.tanyaFounder">Tanya Founder</span><span class="shine"></span>
          </a>
          <a class="nav-wa-short" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener" aria-label="WhatsApp">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
          </a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-glowline"></div>
      <div class="container">
        <div class="footer-grid">
          {/* 1. Brand */}
          <div class="f-col f-brand">
            <h3>PT MESIN KASIR SOLO</h3>
            <div class="f-bar"></div>
            <p data-i18n="footer.tagline">Mitra teknologi terpercaya untuk digitalisasi bisnis di Indonesia. Menyediakan solusi Hardware POS, Software SaaS, dan Jasa Pengembangan Website sejak 2015.</p>
            <div class="f-socials">
              <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener" aria-label="WhatsApp">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
              </a>
              <a href="/#aplikasi" data-tab="aplikasi" aria-label="Aplikasi">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
              </a>
              <a href="/hardware" aria-label="Mesin Kasir">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"></rect><rect x="9" y="9" width="6" height="6"></rect><path d="M15 2v2"></path><path d="M15 20v2"></path><path d="M2 15h2"></path><path d="M2 9h2"></path><path d="M20 15h2"></path><path d="M20 9h2"></path><path d="M9 2v2"></path><path d="M9 20v2"></path></svg>
              </a>
              <a href="/#portal" data-tab="portal" aria-label="Portal">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
              </a>
            </div>
          </div>

          {/* 2. Solusi Digital */}
          <div class="f-col">
            <h4 data-i18n="footer.solusiDigital">Solusi Digital</h4>
            <ul>
              <li><a href="/hardware" data-i18n="footer.links.hardware">Hardware Kasir</a></li>
              <li><a href="/#aplikasi" data-i18n="footer.links.aplikasi">Inovasi Aplikasi</a></li>
              <li><a href="/#portal" data-i18n="footer.links.portalSibos">Portal SIBOS</a></li>
              <li><a href="/#portal" data-i18n="footer.links.portalQalam">Portal QALAM &amp; Dapur</a></li>
            </ul>
          </div>

          {/* 3. Perusahaan & Support */}
          <div class="f-col">
            <h4 data-i18n="footer.perusahaan">Perusahaan &amp; Support</h4>
            <ul>
              <li><a href="/about" data-i18n="footer.links.tentang">Tentang Kami</a></li>
              <li><a href="/#jangkauan" data-i18n="footer.links.area">Area Layanan</a></li>
              <li><a href="/portfolio" data-i18n="footer.links.klien">Klien &amp; Portfolio</a></li>
              <li><a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener" data-i18n="footer.links.download">Download Center</a></li>
              <li><a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener" data-i18n="footer.links.hubungi">Hubungi Kami</a></li>
            </ul>
          </div>

          {/* 4. Hubungi Kami */}
          <div class="f-col f-contact">
            <h4 data-i18n="footer.hubungi">Hubungi Kami</h4>
            <ul>
              <li>
                <span class="f-ic"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg></span>
                <div><small data-i18n="footer.kantorLegal">KANTOR LEGAL</small><p>Perum Graha Tiara 2 B1, Kartasura</p></div>
              </li>
              <li>
                <span class="f-ic"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg></span>
                <div><small data-i18n="footer.kantorOps">KANTOR OPERASIONAL</small><p>Gumiring 04/04, Banjarejo</p></div>
              </li>
              <li>
                <span class="f-ic"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91"></path><path d="M23 7 16.5 13.5"></path><path d="M16.5 7 23 13.5"></path></svg></span>
                <div><small data-i18n="footer.whatsapp">WHATSAPP</small><p><a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener" data-i18n="footer.chatFounder">Chat Founder Langsung</a></p></div>
              </li>
            </ul>
          </div>
        </div>

        {/* Bottom bar */}
        <div class="footer-bottom">
          <p>© {new Date().getFullYear()} <strong>PT Mesin Kasir Solo</strong>. All Rights Reserved.</p>
          <div class="f-legal">
            <a href="#jangkauan">Area Layanan</a>
            <a href="#aplikasi" data-i18n="footer.privasi">Privasi</a>
            <a href="#aplikasi" data-i18n="footer.syarat">Syarat &amp; Ketentuan</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Tombol auto scroll-to-top -->
    <button id="toTop" class="to-top" type="button" data-i18n-aria="nav.aria.top" aria-label="Kembali ke atas">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"></line><polyline points="5 12 12 5 19 12"></polyline></svg>
    </button>

    <!-- Bottom tab bar (mobile native) -->
    <nav class="tabbar" data-i18n-aria="tab.aria.utama" aria-label="Navigasi utama">
      <a href="/" data-tab="beranda" class="active" aria-label="Beranda">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
        <span data-i18n="tab.beranda">Beranda</span>
      </a>
      <a href="/#aplikasi" data-tab="aplikasi" aria-label="Aplikasi">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
        <span data-i18n="tab.aplikasi">Aplikasi</span>
      </a>
      <div class="tab-fab" aria-hidden="false">
        <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener" class="fab" aria-label="Chat Founder">
          <img src="/icon-192.png" alt="" width="28" height="28" />
        </a>
      </div>
      <a href="/hardware" data-tab="mesin" aria-label="Mesin">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"></rect><rect x="9" y="9" width="6" height="6"></rect><path d="M15 2v2"></path><path d="M15 20v2"></path><path d="M2 15h2"></path><path d="M2 9h2"></path><path d="M20 15h2"></path><path d="M20 9h2"></path><path d="M9 2v2"></path><path d="M9 20v2"></path></svg>
        <span data-i18n="tab.mesin">Mesin</span>
      </a>
      <a href="/#portal" data-tab="portal" aria-label="Portal">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
        <span data-i18n="tab.portal">Portal</span>
      </a>
    </nav>
    <script>
      import { initI18n } from '../i18n/client';
      initI18n();

      // Auto scroll-to-top: muncul setelah scroll turun
      const toTop = document.getElementById('toTop');
      if (toTop) {
        const onScroll = () => toTop.classList.toggle('show', window.scrollY > 420);
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
        toTop.addEventListener('click', () => {
          const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollTo({ top: 0, behavior: smooth ? 'smooth' : 'auto' });
        });
      }

      // Tab bar: tandai tab aktif sesuai halaman/hash (bukan hardcoded Beranda)
      const tabs = document.querySelectorAll('.tabbar a[data-tab]');
      if (tabs.length) {
        const path = location.pathname.replace(/\/$/, '');
        const hash = location.hash.replace(/^#/, '');
        let key = 'beranda';
        if (path === '/hardware') key = 'mesin';
        else if (hash === 'aplikasi') key = 'aplikasi';
        else if (hash === 'portal') key = 'portal';
        tabs.forEach((t) => t.classList.toggle('active', t.dataset.tab === key));
      }
    </script>
  </body>
</html>
